PORT=4000
HOST=127.0.0.1
# 0 khi chạy trực tiếp; Docker Compose đặt 1 cho Caddy proxy.
TRUST_PROXY_HOPS=0
# Domain backend trên VPS Việt Nam, không chứa https:// hoặc đường dẫn.
BACKEND_DOMAIN=
MONGODB_URI=
JWT_SECRET=
ADMIN_USERNAME=admin_tanson
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên Tân Sơn
CORS_ORIGINS=http://localhost:3003


# Optional per-process DNS override for Atlas SRV/TXT lookup failures
MONGODB_DNS_SERVERS=

# Zalo App Secret: chỉ lưu ở backend để đổi token số điện thoại từ Mini App
ZALO_APP_SECRET=
ZALO_APP_ID=
ZALO_REDIRECT_URI=https://behdntanson.vercel.app/api/v1/auth/zalo/callback

# Vercel tự dùng MongoDB GridFS. Đặt mongodb để dùng cùng cơ chế khi chạy local.
IMAGE_STORAGE=local
